{
  "appId": "io.github.apcanario.rlx",
  "appName": "rlx",
  "webDir": "www",
  "loggingBehavior": "debug",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "html5mode": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false,
    "resolveServiceWorkerRequests": false
  },
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
